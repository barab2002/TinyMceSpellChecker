# Backend server settings
SPELLCHECK_HOST=0.0.0.0
SPELLCHECK_PORT=8000

# CORS - comma-separated list of allowed origins (use * for internal network)
SPELLCHECK_CORS_ORIGINS=*

# Dictionary paths (inside the container or on the host)
SPELLCHECK_HUNSPELL_DICT_DIR=/app/dictionaries
SPELLCHECK_CUSTOM_DICT_PATH=/app/dictionaries/custom/org_dictionary.json

# Default language for spell checking
SPELLCHECK_DEFAULT_LANGUAGE=he_IL

# Maximum text length accepted (characters)
SPELLCHECK_MAX_TEXT_LENGTH=200000

# Maximum suggestions returned per misspelled word
SPELLCHECK_MAX_SUGGESTIONS=5

# Log level: DEBUG | INFO | WARNING | ERROR
SPELLCHECK_LOG_LEVEL=INFO

# ─── Language control ──────────────────────────────────────────────────────────
# Comma-separated list of BCP-47 language codes to enable.
# Leave empty to auto-discover every .aff/.dic pair in SPELLCHECK_HUNSPELL_DICT_DIR.
# Example: SPELLCHECK_LANGUAGES=he-IL,en-US,ar-SA
SPELLCHECK_LANGUAGES=

# ─── MongoDB (optional) ───────────────────────────────────────────────────────
# When set, the organisational dictionary is stored in MongoDB instead of a JSON file.
# This also enables the word-approval workflow at /approvals.
#
# Local MongoDB:   SPELLCHECK_MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas:   SPELLCHECK_MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
# Docker Compose:  SPELLCHECK_MONGO_URI=mongodb://mongo:27017
SPELLCHECK_MONGO_URI=
SPELLCHECK_MONGO_DB=spellcheck
