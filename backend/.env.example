# Backend server settings
SPELLCHECK_HOST=0.0.0.0
SPELLCHECK_PORT=8000

# CORS - comma-separated list of allowed origins (use * for internal network)
SPELLCHECK_CORS_ORIGINS=*

# Dictionary paths (inside the container or on the host)
SPELLCHECK_HUNSPELL_DICT_DIR=/app/dictionaries
# Legacy JSON file — used only to seed MongoDB on first startup
SPELLCHECK_CUSTOM_DICT_PATH=/app/dictionaries/custom/org_dictionary.json

# MongoDB — durable store for the custom (organisational) dictionary
SPELLCHECK_MONGO_URI=mongodb://mongo:27017
SPELLCHECK_MONGO_DB=spellcheck
SPELLCHECK_MONGO_COLLECTION=custom_dictionary

# How often each worker reloads the dictionary cache from Mongo (minutes).
# Set to 0 to disable the periodic refresh.
SPELLCHECK_DICT_REFRESH_INTERVAL_MINUTES=5

# Default language for spell checking
SPELLCHECK_DEFAULT_LANGUAGE=he_IL

# Maximum text length accepted (characters)
SPELLCHECK_MAX_TEXT_LENGTH=200000

# Maximum suggestions returned per misspelled word
SPELLCHECK_MAX_SUGGESTIONS=5

# Log level: DEBUG | INFO | WARNING | ERROR
SPELLCHECK_LOG_LEVEL=INFO

# External approval service that receives {word, context} when a user clicks
# "הצע למילון" (suggest to dictionary) in the editor
SPELLCHECK_APPROVEIT_URL=
