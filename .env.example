# ─── Docker Compose environment ───────────────────────────────────────────────

# Port on the HOST that the API listens on (container always uses 8000 internally)
API_PORT=8000

# Port for the optional static file server (serves the plugin and example page)
STATIC_PORT=3000

# Log level for the API service: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS origins – use * for internal network, or comma-separated list of origins
# Example: http://intranet.example.com,http://cms.example.com
CORS_ORIGINS=*

# How often each API worker reloads the custom dictionary cache from MongoDB
# (minutes). Set to 0 to disable the periodic refresh.
DICT_REFRESH_INTERVAL_MINUTES=5

# MongoDB connection for the custom (organisational) dictionary.
# Defaults to the bundled `mongo` container — leave unset to use it.
# To use an external MongoDB (e.g. Atlas) instead, set your own connection
# string here; the bundled `mongo` container in docker-compose.yml will then
# just sit unused (safe to remove that service if you don't need it).
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGO_URI=mongodb://mongo:27017

# Database and collection the custom dictionary is stored in.
MONGO_DB=spellcheck
MONGO_COLLECTION=custom_dictionary

# External approval service that receives {word, context} when a user clicks
# "הצע למילון" (suggest to dictionary) in the editor
APPROVEIT_URL=
