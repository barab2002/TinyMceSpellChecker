# ─── Docker Compose environment ───────────────────────────────────────────────

# Port on the HOST that the API listens on (container always uses 8000 internally)
API_PORT=8000

# Port for the optional static file server (serves the plugin and example page)
STATIC_PORT=3000

# Log level for the API service: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# CORS origins – use * for internal network, or comma-separated list of origins
# Example: http://intranet.example.com,http://cms.example.com
CORS_ORIGINS=*

# ─── Language control ─────────────────────────────────────────────────────────
# Comma-separated list of BCP-47 codes to enable.
# Leave empty to auto-discover every .aff/.dic pair in the dictionaries folder.
# Example: LANGUAGES=he-IL,en-US,ar-SA
LANGUAGES=

# ─── MongoDB (optional) ───────────────────────────────────────────────────────
# Set MONGO_URI to enable MongoDB-backed dictionary and the word-approval workflow.
# Leave empty to use the local JSON file at backend/dictionaries/custom/org_dictionary.json.
#
# Uses the bundled mongo service below when set to:
MONGO_URI=mongodb://mongo:27017
MONGO_DB=spellcheck
